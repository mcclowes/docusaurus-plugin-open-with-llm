{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "rootDir": "."
  },
  "include": ["src", "tests", "ambient.d.ts", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
