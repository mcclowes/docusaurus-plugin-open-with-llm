{
  "docusaurus-plugin-content-docs": {
    "default": {
      "path": "/",
      "versions": [
        {
          "name": "current",
          "label": "Next",
          "isLast": true,
          "path": "/",
          "mainDocId": "intro",
          "docs": [
            {
              "id": "intro",
              "path": "/",
              "sidebar": "docs"
            },
            {
              "id": "payments",
              "path": "/payments",
              "sidebar": "docs"
            }
          ],
          "draftIds": [],
          "sidebars": {
            "docs": {
              "link": {
                "path": "/",
                "label": "intro"
              }
            }
          }
        }
      ],
      "breadcrumbs": true
    }
  },
  "docusaurus-plugin-open-with-llm": {
    "default": {
      "enabled": true,
      "buttonLabel": "Open with AI",
      "markdownFile": "index.md",
      "prompt": "Read {url} and answer my questions using it as context.",
      "providers": [
        {
          "label": "Open in ChatGPT",
          "url": "https://chatgpt.com/?q={prompt}"
        },
        {
          "label": "Open in Claude",
          "url": "https://claude.ai/new?q={prompt}"
        }
      ]
    }
  }
}
